# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 환경변수 예시는 커밋한다 (.env* 규칙의 예외)
!.env*.example

# 에이전트 도구 상태
/.omc/

# 스캐폴딩 백업
*.bak-scaffold

# Claude Design seed 산출물 — 에디터 코드 2.4MB. design/*.dc.html 로 재생성한다
/design/ir-generator-screens.html
/design/_tokens.txt

# 캔버스 중간 조립 파일 (_head.html + _b_*.html 로 .dc.html 을 만든다)
/design/_b_*.html
.omc/
