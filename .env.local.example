# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채운다.
# .env.local은 .gitignore(.env*)에 이미 걸려 있어 커밋되지 않는다.

# Supabase 프로젝트 설정 → API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LLM 키는 필요 없다.
#
# 슬라이드 계획은 이 컴퓨터에 설치된 Codex CLI가 만든다. ChatGPT 구독으로
# 동작하므로 API 과금이 없는 대신, 다음 조건을 모두 만족해야 한다.
#
#   1. codex 명령이 PATH에 있을 것        (codex --version)
#   2. ChatGPT 계정으로 로그인돼 있을 것   (codex login status)
#   3. 이 컴퓨터에서 npm run backend:dev 가 떠 있을 것 (Next dev와는 별개 프로세스)
#
# Next.js는 이제 codex를 직접 spawn하지 않는다. backend/server.ts가 codex를
# 부르고, Next는 아래 BACKEND_URL로 그 서버에 HTTP 요청만 보낸다
# (src/lib/deck/generate-client.ts). Vercel 같은 원격 배포에는 codex 바이너리가
# 없으니, backend/server.ts는 codex가 설치·로그인된 이 컴퓨터에서만 띄운다.

# Next → backend/server.ts 로컬 연결 주소. 같은 컴퓨터에서 테스트할 땐 기본값 그대로.
BACKEND_URL=http://localhost:8787

# backend/server.ts가 요구하는 값과 반드시 같아야 한다. 아무 문자열이나 정해서
# 양쪽(.env.local의 Next 쪽, backend/server.ts가 읽는 쪽 — 지금은 같은 .env.local)에
# 동일하게 넣는다. 비워두면 backend/server.ts는 시작 자체를 거부한다(인증 없이 뜨면
# 같은 네트워크의 누구나 이 계정의 Codex 한도를 쓸 수 있기 때문).
BACKEND_SECRET=
